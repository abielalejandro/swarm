# ============================================
# LLM CONFIGURACIÓN - ELIGE TU PROVEEDOR
# ============================================

# Proveedores disponibles:
# openai, deepseek, anthropic, groq, azure, ollama, lm_studio, custom
LLM_PROVIDER=openai

# Modelo según proveedor
LLM_MODEL=gpt-4o-mini

# API Key del proveedor
LLM_API_KEY=sk-your-key-here

# URL base (para proveedores custom o Azure)
LLM_BASE_URL=

# Azure específico
AZURE_API_VERSION=2024-02-15-preview
OLLAMA_URL=http://localhost:11434/v1
LM_STUDIO_URL=http://localhost:1234/v1

# ============================================
# HUMAN OVERRIDE
# ============================================
HUMAN_OVERRIDE_SECRET=change_me
HUMAN_APPROVER_ID=admin
HUMAN_DEPLOYMENT_TOKEN=change_me

# ============================================
# DATABASE
# ============================================
POSTGRES_PASSWORD=swarm_secret

# ============================================
# AUTH (PASETO v4.local en cookie segura)
# ============================================
# Clave simétrica para firmar la sesión: usá >= 32 bytes aleatorios.
PASETO_KEY=change_me_paseto_32_bytes_minimum
# Duración de la sesión en segundos (default 8h).
SESSION_TTL_SECONDS=28800
# Cookie Secure: true (prod/HTTPS), false (dev local por HTTP), o auto
# (lo resuelve por el scheme del request; con proxy usá uvicorn --proxy-headers).
COOKIE_SECURE=true
# Seed del primer usuario (usado por seed_user.py; no dejar valores reales acá).
SEED_USERNAME=admin
SEED_PASSWORD=change_me

# ============================================
# AWS
# ============================================
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_REGION=us-east-1

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO